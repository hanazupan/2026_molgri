
configfile: "workflow/config/example_config.yaml"

import numpy as np
from workflow.helpers.PATHS import PATH_INPUT_MOLECULES, PATH_OUTPUT, NAME_SIMULATION_FOLDER


all_translation_coo = np.array(config["grid"]["translation_subgrids_A"]).reshape(-1)

if 'None' in all_translation_coo:
    from molgri.molecules.find_unit_cell import get_x_y_grid_inputs
    path_input = f"{PATH_INPUT_MOLECULES}{config['pseudotrajectory']['molecule_1']}.gro"
    num_x_points = config["grid"]["translation_subgrids_A"][0][2]
    num_y_points = config["grid"]["translation_subgrids_A"][1][2]
    z = config["grid"]["translation_subgrids_A"][2]
    x, y = get_x_y_grid_inputs(path_input, num_x_points=num_x_points, num_y_points=num_y_points)
    config["grid"]["translation_subgrids_A"] = [x, y, z]

include: "rules/general.smk"
include: "rules/pseudotrajectories.smk"
include: "rules/gromacs.smk"
include: "rules/energy.smk"

MOLECULE_NAMES = f"{config['pseudotrajectory']['molecule_1']}_{config['pseudotrajectory']['molecule_2']}/"
NETWORK_NAME = f"{config['grid']['unique_network_name']}/"

EXPERIMENT_FULL_PATH = f"{PATH_OUTPUT}{MOLECULE_NAMES}{NETWORK_NAME}"


rule all:
    input:
        f"{EXPERIMENT_FULL_PATH}{NAME_SIMULATION_FOLDER}energy.csv",
        expand(f"{EXPERIMENT_FULL_PATH}molecule{{i}}/full_energy.xvg", i=[1,2]),
        f"{EXPERIMENT_FULL_PATH}{NAME_SIMULATION_FOLDER}energy.xvg",
        f"{EXPERIMENT_FULL_PATH}config_used.yaml",