configfile: "workflow/config/example_config.yaml"


from workflow.helpers.PATHS import auto_create_grid

config = auto_create_grid(config)

if config["perform_simulation"]:
    subfolder = "simulation/"
else:
    subfolder = "pseudosimulation/"

pathvars:
    molecule1 = config["pseudotrajectory"]["molecule_1"],
    molecule2 = config["pseudotrajectory"]["molecule_2"],
    ext_str = config["pseudotrajectory"]["structure_ending"],
    ext_trj = config["pseudotrajectory"]["trajectory_ending"],
    network = f"{config['grid']['unique_network_name']}/",
    molecules = f"<molecule1>_<molecule2>/",
    inputs = "inputs/",
    inputs_gromacs =f"<inputs>default_gromacs/<molecules>",
    inputs_vmd =f"<inputs>vmd_scripts/<molecules>",
    inputs_structures = f"<inputs>one_molecule_structures/",
    outputs = f'nobackup/<molecules><network>{subfolder}',
    outputs_network = f'nobackup/<molecules><network>network/',
    outputs_gromacs = f'<outputs>gromacs/',
    outputs_indices = f'<outputs>important_indices/',
    outputs_vmd = f'<outputs>vmd/',
    outputs_plots = f'<outputs>plots/',
    outputs_plots_lowest = f'<outputs_plots>lowest/',
    outputs_frame_plots = f'<outputs_plots>frames/',
    outputs_other_plots = f'<outputs_plots>other/',


include: "rules/general.smk"
include: "rules/grids.smk"
include: "rules/pseudotrajectories.smk"
include: "rules/energy.smk"
include: "rules/molecular_visualizations.smk"

if config["perform_simulation"]:
    include: "rules/simulation_only.smk"
else:
    include: "rules/rerun_only.smk"

N=[1, 5, 10, 50]
view_i=[1,2]

if config["perform_simulation"]:
    rule all:
        input:
            f"<outputs_other_plots>violin_plot_energies.png",
            expand(f"<outputs_plots_lowest>lowest_{{N}}_binding_energies_view{{view_i}}.tga",N=N,view_i=view_i),
            f"<outputs_frame_plots>frame_22_view1.tga",
            expand(f"<outputs_indices>lowest_{{N}}_binding_energies.txt", N=[1, 5, 10, 50]),
            f"<outputs>energy.csv",
            f"<outputs_gromacs>energy.xvg",
            f"<outputs_gromacs>structure.gro",
            f"<outputs>config_used.yaml",
else:
    rule all:
        input:
        expand(f"{EXPERIMENT_FULL_PATH}{NAME_PLOTS}ring_vector.png", N=[1, 3, 10, 100, 250, 1000]),
        expand(f"{EXPERIMENT_FULL_PATH}{NAME_PLOTS}ring_position_lowest_{{N}}.png", N=[1, 3, 10, 100, 250, 500]),
            f"<outputs>indices_interpretation.csv",
            f"<outputs_other_plots>violin_plot_energies.png",
            expand(f"<outputs_plots_lowest>lowest_{{N}}_binding_energies_view{{view_i}}.tga", N=N, view_i=view_i),
            f"<outputs>network_energy.pkl",
            f"<outputs_frame_plots>frame_22_view1.tga",
            expand(f"<outputs_indices>lowest_{{N}}_binding_energies.txt", N=N),
            f"<outputs>energy.csv",
            f"<outputs_gromacs>energy.xvg",
            f"<outputs_gromacs>trajectory.xtc",
            f"<outputs_network>grid.npy",
            f"<outputs>config_used.yaml",